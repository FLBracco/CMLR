# development | production. En producción habilita trust proxy y logging solo de errores.
NODE_ENV=development

PORT=
CORS_ORIGIN=

DATABASE_HOST=
DATABASE_PORT=

DATABASE_USER=
DATABASE_PASSWORD=

DATABASE_NAME=

# false en Docker local; true contra un proveedor managed (Neon, Supabase, etc.)
DATABASE_SSL=false

# En producción, JWT_SECRET y SUPERADMIN_PASSWORD van como secretos del
# proveedor de hosting (nunca en un .env versionado).
JWT_SECRET=
JWT_EXPIRES_IN=2h

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
